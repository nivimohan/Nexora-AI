# ─────────────────────────────────────────
# NEXORA AI — Backend Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────

# MongoDB URI (local Compass or Atlas cloud)
MONGO_URI=mongodb://localhost:27017/nexora_ai

# Server port
PORT=5000

# JWT secret for auth token signing (use a long random string in production)
JWT_SECRET=nexora_super_secret_jwt_key_change_me

# CORS allowed origin (frontend dev server)
CLIENT_ORIGIN=http://localhost:5173

# Environment mode
NODE_ENV=development

# Gemini API Keys (Multi-Key Rotation & 429 Rate Limit Fallback)
GEMINI_API_KEY_PRIMARY=your_primary_gemini_api_key_here
GEMINI_API_KEY_SECONDARY=your_secondary_gemini_api_key_here
# Single key fallback (if primary/secondary not specified)
GEMINI_API_KEY=your_gemini_api_key_here
